{
  "scenario_id": "grid_09_frequency_bess_coupled",
  "name": "Frequency Nadir and BESS Response — Droop Coupling",
  "description": "Grid frequency nadir and BESS active power response are coupled through the droop control law: larger frequency drops trigger proportionally larger BESS injections, creating a negative correlation.",
  "models": [
    {
      "id": "M1",
      "name": "Grid Frequency Response Model",
      "type": "SimulationModel",
      "elements": [
        {
          "id": "e1",
          "name": "Grid Frequency Nadir",
          "symbol": "f_nadir",
          "unit": "Hz",
          "description": "Minimum frequency after N-1 generator trip. Coupled to BESS through droop.",
          "uncertainty": {
            "type": "probabilistic",
            "source": "power-grid-frequency.org (osf.io/m43tg): Continental Europe nadir statistics",
            "distribution": "gaussian",
            "mean": 49.55,
            "std": 0.15
          },
          "classification": {
            "development_phase": "Run-Time Level",
            "reducibility_level": "Partially Reducible",
            "nature": "Aleatory",
            "kind": "Measurement Uncertainty",
            "atomic_component_type": "Physical",
            "physical_component_type": "Electrical",
            "composite_type": "Cyber-Physical",
            "autonomy_type": "Non-Autonomous",
            "location_type": "Parameter",
            "source_type": "Environment",
            "pattern_type": "Persistent",
            "perspective_type": "Objective",
            "effect_type": "continuous probabilistic",
            "level_type": "1st Level",
            "risk_type": "High",
            "risk_scale": 88
          }
        },
        {
          "id": "e2",
          "name": "BESS Active Power Response",
          "symbol": "P_bess",
          "unit": "MW",
          "description": "BESS power injection at frequency nadir. Negatively correlated with f_nadir.",
          "uncertainty": {
            "type": "probabilistic",
            "source": "ENTSO-E FCR tender data: BESS response power variation across regulation events",
            "distribution": "gaussian",
            "mean": 18.0,
            "std": 4.0
          },
          "classification": {
            "development_phase": "Run-Time Level",
            "reducibility_level": "Partially Reducible",

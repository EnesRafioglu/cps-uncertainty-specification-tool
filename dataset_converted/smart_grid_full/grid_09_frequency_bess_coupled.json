            "location_type": "Parameter",
            "source_type": "Managed System Uncertainty",
            "pattern_type": "Persistent",
            "perspective_type": "Objective",
            "effect_type": "continuous probabilistic",
            "level_type": "1st Level",
            "risk_type": "High",
            "risk_scale": 82
          }
        }
      ]
    },
    {
      "id": "M2",
      "name": "Grid Stability Requirements",
      "type": "RequirementModel",
      "elements": [
        {
          "id": "e3",
          "name": "Minimum Frequency Limit",
          "symbol": "f_min",
          "unit": "Hz",
          "description": "ENTSO-E: below 49.0 Hz triggers under-frequency load shedding",
          "fixed_value": 49.0
        },
        {
          "id": "e4",
          "name": "Minimum BESS Response",
          "symbol": "P_bess_min",
          "unit": "MW",
          "description": "Contracted FCR minimum: BESS must deliver ≥10 MW within 30 s",
          "fixed_value": 10.0
        }
      ]
    }
  ],
  "consistency_relations": [
    {
      "id": "CR1_3",
      "from_element_id": "e1",
      "to_element_id": "e3",
      "operator": ">=",
      "expression": "f_nadir >= f_min",
      "upr_type": "constraint_based",
      "upr_sigma": "σ(f_nadir) = f_nadir if f_nadir >= f_min, else ∅",
      "upr_description": "Stability constraint on frequency dimension of 2D CZ."
    },
    {
      "id": "CR2_4",
      "from_element_id": "e2",
      "to_element_id": "e4",
      "operator": ">=",
      "expression": "P_bess >= P_bess_min",
      "upr_type": "constraint_based",
      "upr_sigma": "σ(P_bess) = P_bess if P_bess >= P_bess_min, else ∅",
      "upr_description": "Contract constraint on BESS power dimension of 2D CZ."
    }
  ]

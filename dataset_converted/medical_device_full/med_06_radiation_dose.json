            "distribution": "gaussian",
            "mean": 59.8,
            "std": 1.5
          },
          "classification": {
            "development_phase": "Run-Time Level",
            "reducibility_level": "Partially Reducible",
            "nature": "Aleatory",
            "kind": "Measurement Uncertainty",
            "atomic_component_type": "Physical",
            "physical_component_type": "Electrical",
            "composite_type": "Cyber-Physical",
            "autonomy_type": "Autonomous",
            "location_type": "Parameter",
            "source_type": "Managed System Uncertainty",
            "pattern_type": "Persistent",
            "perspective_type": "Objective",
            "effect_type": "continuous probabilistic",
            "level_type": "1st Level",
            "risk_type": "High",
            "risk_scale": 90
          }
        }
      ]
    },
    {
      "id": "M2",
      "name": "Clinical Prescription Model",
      "type": "RequirementModel",
      "elements": [
        {
          "id": "e2",
          "name": "Prescribed Minimum Dose",
          "symbol": "D_min",
          "unit": "Gy",
          "description": "ICRU 83 D95 prescription dose for tumour control",
          "fixed_value": 58.0

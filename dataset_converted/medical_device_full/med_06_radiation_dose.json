      "from_element_id": "e1",
      "to_element_id": "e2",
      "operator": ">=",
      "expression": "D_tumour >= D_min",
      "upr_type": "constraint_based",
      "upr_sigma": "σ(D_tumour) = D_tumour if D_tumour >= D_min, else ∅",
      "upr_description": "The ICRU 83 D95 prescription minimum guards the delivered dose uncertainty set; doses below 58 Gy indicate underdosing."
    }
  ]

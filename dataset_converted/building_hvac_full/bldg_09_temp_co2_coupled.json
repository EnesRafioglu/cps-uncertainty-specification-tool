            "source_type": "Environment",
            "pattern_type": "Persistent",
            "perspective_type": "Objective",
            "effect_type": "continuous probabilistic",
            "level_type": "1st Level",
            "risk_type": "Medium",
            "risk_scale": 65
          }
        }
      ]
    },
    {
      "id": "M2",
      "name": "Building Comfort and Air Quality Requirements",
      "type": "RequirementModel",
      "elements": [
        {
          "id": "e3",
          "name": "Maximum Comfort Temperature",
          "symbol": "T_max",
          "unit": "°C",
          "description": "ISO 7730 Category B upper comfort limit",
          "fixed_value": 24.0
        },
        {
          "id": "e4",
          "name": "Maximum CO2 Concentration",
          "symbol": "C_max",
          "unit": "ppm",
          "description": "ASHRAE 62.1 indoor air quality limit",
          "fixed_value": 1000.0
        }
      ]
    }
  ],
  "consistency_relations": [
    {
      "id": "CR1_3",
      "from_element_id": "e1",
      "to_element_id": "e3",
      "operator": "<=",
      "expression": "T_room <= T_max",
      "upr_type": "constraint_based",
      "upr_sigma": "σ(T_room) = T_room if T_room <= T_max, else ∅",
      "upr_description": "Comfort constraint on temperature dimension of 2D CZ."
    },
    {
      "id": "CR2_4",
      "from_element_id": "e2",
      "to_element_id": "e4",
      "operator": "<=",
      "expression": "C_CO2 <= C_max",
      "upr_type": "constraint_based",
      "upr_sigma": "σ(C_CO2) = C_CO2 if C_CO2 <= C_max, else ∅",
      "upr_description": "Air quality constraint on CO2 dimension of 2D CZ."
    }
  ]

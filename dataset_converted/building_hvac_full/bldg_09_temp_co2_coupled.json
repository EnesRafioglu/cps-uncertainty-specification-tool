            "location_type": "Parameter",
            "source_type": "Environment",
            "pattern_type": "Persistent",
            "perspective_type": "Objective",
            "effect_type": "continuous probabilistic",
            "level_type": "1st Level",
            "risk_type": "Medium",
            "risk_scale": 60
          }
        },
        {
          "id": "e2",
          "name": "CO2 Concentration",
          "symbol": "C_CO2",
          "unit": "ppm",
          "description": "CO2 in occupied zone. Negatively correlated with T_room via ventilation rate.",
          "uncertainty": {
            "type": "probabilistic",
            "source": "PLEIAData (doi:10.1038/s41597-023-02023-3)",
            "distribution": "gaussian",
            "mean": 850.0,
            "std": 100.0
          },
          "classification": {
            "development_phase": "Run-Time Level",

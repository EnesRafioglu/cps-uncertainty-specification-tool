{
  "scenario_id": "bldg_09_temp_co2_coupled",
  "name": "Room Temperature and CO2 — Ventilation Coupling",
  "description": "Room temperature and CO2 are both controlled by the HVAC ventilation rate, creating a negative correlation: more ventilation cools the room and reduces CO2 simultaneously.",
  "models": [
    {
      "id": "M1",
      "name": "Building Zone Model",
      "type": "SimulationModel",
      "elements": [
        {
          "id": "e1",
          "name": "Zone Air Temperature",
          "symbol": "T_room",
          "unit": "°C",
          "description": "Steady-state zone temperature. Negatively correlated with CO2 through ventilation.",
          "uncertainty": {
            "type": "probabilistic",
            "source": "PLEIAData (doi:10.1038/s41597-023-02023-3)",
            "distribution": "gaussian",
            "mean": 21.5,
            "std": 1.0
          },
          "classification": {
            "development_phase": "Run-Time Level",
            "reducibility_level": "Partially Reducible",
